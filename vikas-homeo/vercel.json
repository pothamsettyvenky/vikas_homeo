{
  "framework": "create-react-app",

  "buildCommand": "npm run build",

  "outputDirectory": "build",

  "installCommand": "npm install",

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api|static|favicon.ico|manifest.json|logo192.png|logo512.png).*)",
      "destination": "/index.html"
    }
  ]
}